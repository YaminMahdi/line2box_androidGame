<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/orangeY"> <!-- Ripple effect color -->

    <!-- Button states -->
    <item>
        <selector>
            <!-- Disabled state -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke android:width="2dp" android:color="@color/grayY" />
                    <solid android:color="@color/grayX"/>
                </shape>
            </item>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/orangeZ"
                        android:startColor="@color/orangeX"
                        android:type="linear" />
                    <stroke android:width="4dp" android:color="@color/orangeY" />
                </shape>
            </item>
        </selector>
    </item>

</ripple>
