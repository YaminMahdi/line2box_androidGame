<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/redY"> <!-- Ripple effect color -->

    <!-- Button states -->
    <item>
        <selector>
            <!-- Disabled state -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <stroke android:width="3dp" android:color="@color/grayY" />
                    <solid android:color="@color/grayX"/>
                </shape>
            </item>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <stroke android:width="3dp" android:color="@color/redY" />
                    <solid android:color="@color/redX"/>
                </shape>
            </item>
        </selector>
    </item>

</ripple>
