<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/yellowX"> <!-- Ripple effect color -->

    <!-- Button states -->
    <item>
        <selector>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_18sdp" />
                    <stroke android:width="@dimen/_2sdp" android:color="@color/yellowY" />
                    <solid android:color="@color/yellowX" />
                </shape>
            </item>
        </selector>
    </item>

</ripple>
