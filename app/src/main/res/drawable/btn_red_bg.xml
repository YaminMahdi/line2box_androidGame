<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/redYy"> <!-- Ripple effect color -->

    <!-- Button states -->
    <item>
        <selector>
            <!-- Default state -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="30dp" />
                    <stroke android:width="3dp" android:color="@color/redYy" />
                    <solid android:color="@color/redXx"/>
                </shape>
            </item>
        </selector>
    </item>

</ripple>
