<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/item_bg"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingBottom="12dp"
    tools:context=".presentation.adapter.ScoreListAdapter"
    tools:ignore="UselessParent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <TextView
            android:id="@+id/timeId"
            android:layout_width="wrap_content"
            android:layout_height="12sp"
            android:fontFamily="@font/sortie"
            android:text="Play Time"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="14sp"
            android:layout_height="14sp"
            android:src="@drawable/icon_friends"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/redShow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sortie"
            android:paddingVertical="2sp"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="HHHHHHHH: 33" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="15sp"
            android:layout_gravity="center"
            android:layout_weight=".18"
            android:fontFamily="@font/brad"
            android:gravity="center"
            android:text="@string/vs"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/blueShow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sortie"
            android:gravity="end"
            android:paddingVertical="2sp"
            android:textColor="@color/white"
            android:textSize="20sp"
            tools:text="GGGGGG: 43" />
    </LinearLayout>
</LinearLayout>