<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/btn_rank_bg"
    tools:context=".presentation.adapter.ScoreListAdapter">

    <TextView
        android:id="@+id/timeId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/sortie"
        android:layout_marginTop="10dp"
        android:text="1 Days Ago"
        android:textColor="@color/white"
        android:textSize="9sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Player 1 -->
    <LinearLayout
        android:id="@+id/linLayoutPlr1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/scoreBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/plr1Nm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sortie"
                android:maxLines="1"
                android:textColor="@color/cocZz"
                android:textSize="15sp"
                tools:text="Player One" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sortie"
                android:paddingStart="2dp"
                android:text="lvl."
                android:textColor="@color/white"
                android:textSize="9sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/plr1Lvl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sortie"
                android:textColor="@color/greenY"
                android:textSize="10sp"
                tools:text="5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="15sp"
                android:layout_height="15sp"
                android:src="@drawable/icon_trophy" />

            <TextView
                android:id="@+id/plr1Cup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/sortie"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="+60" />
        </LinearLayout>
    </LinearLayout>

    <!-- Score badge -->
    <LinearLayout
        android:id="@+id/scoreBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/box_chat"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/linLayoutPlr2"
        app:layout_constraintStart_toEndOf="@id/linLayoutPlr1"
        app:layout_constraintTop_toBottomOf="@+id/timeId">

        <TextView
            android:id="@+id/plr1Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sortie"
            android:textColor="@color/whiteY"
            android:textSize="18sp"
            tools:text="12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="@font/brad"
            android:text="-"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/plr2Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sortie"
            android:textColor="@color/whiteY"
            android:textSize="18sp"
            tools:text="24" />
    </LinearLayout>

    <!-- Player 2 -->
    <LinearLayout
        android:id="@+id/linLayoutPlr2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/scoreBadge"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/plr2Nm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sortie"
                android:maxLines="1"
                android:textColor="@color/cocZz"
                android:textSize="15sp"
                tools:text="Player Two" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sortie"
                android:paddingStart="2dp"
                android:text="lvl."
                android:textColor="@color/white"
                android:textSize="9sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/plr2Lvl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sortie"
                android:textColor="@color/greenY"
                android:textSize="10sp"
                tools:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/plr2Cup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/sortie"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="+30" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="15sp"
                android:layout_height="15sp"
                android:src="@drawable/icon_trophy" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
